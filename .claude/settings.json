{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_TELEMETRY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(go version *)",
      "Bash(go env *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(grep -r *)",
      "Bash(grep -v *)",
      "Bash(./dir-age.exe *)"      
    ],
    "additionalDirectories": [
      "\\tmp"
    ]
  }
}
